# dinner-harness repo — ignore build/runtime artifacts only.
# Canonical content (content/, assets/, adapters/, harness.toml, install.py) is tracked.
dist/
__pycache__/
*.pyc
*.pyo
*.pyd
# hook handler logs (runtime; also excluded from the harness copy manifest)
logs/
# Two-CLI bus artifacts written when the orchestrator runs with --repo . here
# (smoke/dev). The tracked templates live at assets/claude/*.template.md.
HANDOFF.md
RESULT.md
# JetBrains IDE
.idea/
# omo run-continuation state (per-session runtime)
.omo/
# Orphaned tempfile.TemporaryDirectory() dirs from sandboxed test runs (see
# investigation: Codex Windows sandbox denies deleting real-OS-temp files,
# which can redirect Python's tempfile fallback into the repo root)
/tmp????????/
.tmp-builder-guard-tests/
.tmp-orchestrator-tests/
.tmp-tests/
