{
  "version": 1,
  "content_patterns": [
    { "name": "aws_access_key", "regex": "AKIA[0-9A-Z]{16}",              "severity": "critical" },
    { "name": "github_pat",     "regex": "gh[ps]_[A-Za-z0-9]{36,}",        "severity": "critical" },
    { "name": "slack_token",    "regex": "xox[bpars]-[A-Za-z0-9-]{10,}",   "severity": "critical" },
    { "name": "anthropic_api_key", "regex": "(?<![A-Za-z0-9])sk-ant-(?:api|admin|oat|ort)\\d{2}-[A-Za-z0-9_-]{20,}", "severity": "critical" },
    { "name": "openai_api_key", "regex": "(?<![A-Za-z0-9])sk-(?:proj|svcacct|admin|None)-[A-Za-z0-9_-]{40,}|(?<![A-Za-z0-9])sk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}", "severity": "critical" },
    { "name": "google_api_key", "regex": "AIza[0-9A-Za-z_-]{35}",           "severity": "critical" },
    { "name": "pem_block",      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "severity": "critical" }
  ],
  "path_patterns": [
    { "name": "credentials_file", "regex": "(^|[/\\\\])\\.credentials([^/\\\\]*)$", "severity": "critical" },
    { "name": "env_file",         "regex": "(?i)(^|[/\\\\])\\.env(\\.[^/\\\\]+)?$", "severity": "high" },
    { "name": "ssh_material", "regex": "(?i)(^|[/\\\\])\\.ssh([/\\\\]|$)|(^|[/\\\\])id_(rsa|dsa|ecdsa|ed25519)(_sk)?$", "severity": "high", "command": false },
    { "name": "private_key_file", "regex": "(?i)[^/\\\\]\\.(?:pem|key|p12|pfx|p8|keystore|jks|mobileprovision)$", "severity": "high", "command": false },
    { "name": "credential_dotfile", "regex": "(?i)(^|[/\\\\])([._]netrc|\\.pgpass)$|(^|[/\\\\])\\.aws[/\\\\]credentials$", "severity": "high", "command": false }
  ],
  "command_patterns": [
    { "name": "env_redirect", "regex": "(?i)(?<![-=<>])>[>|]?\\s*(?:\"(?:[^\"\\n]*[/\\\\])?\\.env(?:\\.[^\"/\\\\\\n]*)?\"|'(?:[^'\\n]*[/\\\\])?\\.env(?:\\.[^'/\\\\\\n]*)?'|(?:(?:\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s\"'|;&<>()])*[/\\\\])?[\"']?\\.env(?:\\.[^\\s\"'|;&<>()/\\\\]*)?[\"']?(?![^\\s\"'|;&<>()]))", "severity": "high" },
    { "name": "env_file_arg", "regex": "(?i)(?:^|[;&|({]\\s*)(?:get-content|gc|cat|type|more|less|head|tail|bat|copy-item|copy|cp)(?=\\s)[^;&|\\n]*?(?:[\\s\"'=/\\\\])\\.env(?:\\.[\\w.-]+)?(?=$|[\\s\"'|;&<>),])", "severity": "high" },
    { "name": "key_material_read", "regex": "(?i)(?:^|[;&|({]\\s*)(?:get-content|gc|cat|type|more|less|head|tail|bat|copy-item|copy|cp|xxd|base64|od|strings|format-hex|certutil)(?=\\s)[^;&|\\n]*?[\\s\"'=/\\\\~](?:\\.ssh[/\\\\]|id_(?:rsa|dsa|ecdsa|ed25519)(?:_sk)?(?=$|[\\s\"'|;&<>),])|[^\\s\"'=/\\\\|;&<>()$*?\\[\\]]*[^\\s\"'=/\\\\|;&<>()$.*?\\[\\]]\\.(?:pem|key|p12|pfx|p8|keystore|jks|mobileprovision)(?=$|[\\s\"'|;&<>),])|(?:[._]netrc|\\.pgpass)(?=$|[\\s\"'|;&<>),])|\\.aws[/\\\\]credentials(?=$|[\\s\"'|;&<>),]))", "severity": "high" }
  ]
}
