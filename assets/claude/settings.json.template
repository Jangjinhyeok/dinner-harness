{
  "_template": "Generated by install.py: <CLAUDE_HOME> is substituted with the install dest (e.g. C:/Users/<you>/.claude — drive + username from the actual dest, so it is not pinned to C:) and this _template key is stripped. Absolute BAT paths are required by the Claude Code Windows hook command argument-escaping workaround — see hooks/README.md.",
  "extraKnownMarketplaces": {},
    "env": {
      "CLAUDE_SECRET_SCAN_MODE": "enforce",
      "CLAUDE_SHELL_GUARD_MODE": "dryrun"
    },
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "Read(**/.env*)",
      "Read(**/.credentials*)",
      "Read(//**/.env*)",
      "Read(//**/.credentials*)",
      "Read(//**/.ssh/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_dsa)",
      "Read(//**/id_ecdsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p8)",
      "Read(//**/*.keystore)",
      "Read(//**/*.jks)",
      "Read(//**/*.mobileprovision)",
      "Read(//**/.netrc)",
      "Read(//**/_netrc)",
      "Read(//**/.pgpass)",
      "Read(//**/.aws/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/secret_scan.cmd"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/shell_guard.cmd"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/scope_check.cmd"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/suggest_compact.cmd"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/learning_log.cmd"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/learning_log.cmd"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<CLAUDE_HOME>/hooks/launchers/route_nudge.cmd"
          }
        ]
      }
    ]
  }
}
